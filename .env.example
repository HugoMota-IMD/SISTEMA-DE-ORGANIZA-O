# Copie para .env somente se precisar alterar as opções locais.
# Nenhuma credencial real deve ser registrada neste arquivo.
APP_LOCAL_MODE=true
APP_DEBUG=false
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Obrigatória quando APP_LOCAL_MODE=false; gerar valor aleatório fora do código.
APP_SECRET_KEY=
# Origens HTTPS exatas, separadas por vírgula, somente após aprovar hospedagem.
APP_CSRF_TRUSTED_ORIGINS=
# Origem privada HTTPS exata do nó servidor, obtida em tailscale status --json.
# Backend continua em 127.0.0.1. A opção adiciona somente este host/origem e
# protege os cookies HTTPS sem desativar o acesso HTTP local existente.
# APP_PRIVATE_HTTPS_ORIGIN=https://nome-do-servidor.sua-tailnet.ts.net
# APP_DB_PATH=C:/caminho-exclusivo-do-projeto/data/finance.sqlite3
# Preparação hospedada: preencher segredos somente no painel Render/ambiente seguro.
# APP_ENVIRONMENT=production
# APP_LOCAL_MODE=false
# APP_REGISTRATION_MODE=approval
# APP_READ_ONLY=true
# DATABASE_URL=conexao-postgresql-pooled-secreta
# DATABASE_URL_UNPOOLED=conexao-postgresql-direta-secreta
# APP_ALLOWED_HOSTS=host-publico-exato
# APP_CSRF_TRUSTED_ORIGINS=https://host-publico-exato
# APP_PRIVATE_HTTPS_ORIGIN pertence somente ao Tailscale local; omitir no Render.
